cabal-version:   3.0
name:            weed-lang
version:         0.1.0.0
license:         MIT
author:          Bazinga_9000
maintainer:      bazninethousand@gmail.com
build-type:      Simple

common warnings
    ghc-options: -Wall

executable weed
    import:           warnings
    main-is:          Main.hs
    build-depends:    base
                     , mtl
                     , containers
                     , QuickCheck
    hs-source-dirs:   src
    default-language: Haskell2010
    other-modules:    AST, PrettyPrint,
                      TypeChecker, TypeChecker.Types, TypeChecker.Subst, TypeChecker.BuiltinTypes, TypeChecker.Infer,
                      Evaluator, Evaluator.Types, Evaluator.Builtins, Evaluator.WeedNumber


test-suite test-weed
    type:             exitcode-stdio-1.0
    main-is:          Tests.hs
    hs-source-dirs:   src
    default-language: Haskell2010
    other-modules:    AST,
                      TypeChecker, TypeChecker.Types, TypeChecker.Subst,
                      TypeChecker.BuiltinTypes, TypeChecker.Infer
    build-depends:    base
                    , mtl
                    , containers
                    , QuickCheck
                    , tasty
                    , tasty-hunit
